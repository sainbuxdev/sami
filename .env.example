# ─────────────────────────────────────────────────────────────
# Sami's iPhone - environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit your real .env file.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Prisma). Use a hosted Postgres (Supabase / Neon / Vercel Postgres).
# Supabase note: use the connection POOLER (IPv4). Any "@" in the password must be encoded as %40.
#   DATABASE_URL = transaction pooler (port 6543, runtime queries)
#   DIRECT_URL   = session pooler   (port 5432, used by prisma migrate / db push)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Secret used to sign admin session cookies (JWT). Use a long random string.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-secret-string-at-least-32-chars"

# Seed admin credentials (used by `npm run db:seed` to create the first admin).
ADMIN_EMAIL="sami@samisiphone.com"
ADMIN_PASSWORD="ChangeThisStrongPassword123!"

# Default WhatsApp number in international format (no +, no spaces).
# Seeds store settings; Sami can change it later from Admin -> Settings.
# Example for Pakistan: 923001234567
WHATSAPP_NUMBER="923001234567"

# ── Image storage ────────────────────────────────────────────
# "local"       -> saves to /public/uploads (dev only; NOT persistent on Vercel)
# "vercel-blob" -> uploads to Vercel Blob (persistent CDN, recommended on Vercel)
# Leave unset to auto-detect: uses Vercel Blob when BLOB_READ_WRITE_TOKEN exists.
STORAGE_DRIVER="local"

# Vercel Blob token. On Vercel, add a Blob store and this is injected
# automatically. For local uploads to Blob, copy it from the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=""

# Public site URL (absolute URLs for SEO / Open Graph / sitemap).
# On Vercel you can leave this blank; it falls back to the deployment URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
