// Sami's iPhone - Prisma schema
//
// Uses PostgreSQL (works locally and on Vercel with a hosted Postgres such as
// Neon, Vercel Postgres, or Supabase). Set DATABASE_URL to your connection
// string. The schema avoids provider-specific native types so it stays portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through the transaction pooler (pgbouncer).
  url       = env("DATABASE_URL")
  // Schema changes (db push / migrate) use the direct session pooler.
  directUrl = env("DIRECT_URL")
}

/// A single iPhone listing in the store's inventory.
model Product {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  imageUrl      String // cover image (first of `images`), kept for cards + back-compat
  images        String   @default("[]") // JSON array of all image URLs, ordered (cover first)
  batteryHealth Int // 0-100, displayed as "89%"
  condition     Int // 1–10, displayed as "9/10"
  price         Int // whole PKR, displayed as "PKR 98,000"
  withBox       Boolean  @default(false)
  details       String // free-text description
  isAvailable   Boolean  @default(true)
  featured      Boolean  @default(false)
  isDemo        Boolean  @default(false) // marks seeded/demo data for easy cleanup
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── Extensibility: optional fields reserved for future versions ──
  // storage     String?
  // color       String?
  // simType     String?
  // ptaStatus   String?
  // location    String?
  // imei        String?
  // warranty    String?
  // accessories String?

  @@index([isAvailable])
  @@index([featured])
  @@index([createdAt])
}

/// The single admin account (extensible to multiple admins later).
model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Sami")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Store-wide settings. A single row (id = "store") holds editable configuration
/// such as the WhatsApp number, so it is never hardcoded in the app.
model Settings {
  id               String   @id @default("store")
  storeName        String   @default("Sami's iPhone")
  whatsappNumber   String   @default("923001234567")
  storeDescription String   @default("Premium iPhones. Simple. Transparent. Trusted.")
  updatedAt        DateTime @updatedAt
}
